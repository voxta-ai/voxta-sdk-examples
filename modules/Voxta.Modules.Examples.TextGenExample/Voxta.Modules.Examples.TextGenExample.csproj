<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Voxta.Sdk.Modules" Version="1.12.0" />
        <!-- Base classes for text generation services: the client contract, TextGenServiceBase,
             the shared preset fields, and the presets/testing providers. -->
        <PackageReference Include="Voxta.Shared.LLMUtils" Version="1.12.0" />
    </ItemGroup>

    <!-- The module logo is loaded from the assembly at runtime, so it must be embedded. -->
    <ItemGroup>
        <EmbeddedResource Include="Assets\textgen-example.svg" />
    </ItemGroup>

</Project>
