<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Dependencies next to the DLL, so Voxta can load the build folder as a dev folder. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <!-- ExcludeAssets="runtime": Voxta provides Voxta.* assemblies at runtime. -->
        <PackageReference Include="Voxta.Sdk.Modules" Version="1.13.0-alpha.6" ExcludeAssets="runtime" />
        <!-- Base classes for text generation services: the client contract, TextGenServiceBase,
             the shared preset fields, and the presets/testing providers. -->
        <PackageReference Include="Voxta.Shared.LLMUtils" Version="1.13.0-alpha.6" />
    </ItemGroup>

    <!-- The module logo is loaded from the assembly at runtime, so it must be embedded. -->
    <ItemGroup>
        <EmbeddedResource Include="Assets\textgen-example.svg" />
    </ItemGroup>

</Project>
