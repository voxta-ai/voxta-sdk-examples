<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Dependencies next to the DLL, so Voxta can load the build folder as a dev folder. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <!-- CS9113: unread primary constructor parameters (ToolsExampleChatAugmentationInstance.session). -->
        <NoWarn>$(NoWarn);CS9113</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- ExcludeAssets="runtime": Voxta provides Voxta.* assemblies at runtime. -->
        <PackageReference Include="Voxta.Sdk.Modules" Version="1.13.0-alpha.2" ExcludeAssets="runtime" />
    </ItemGroup>

</Project>
