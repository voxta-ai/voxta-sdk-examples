<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>voxta-chat</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
        <TargetFramework>net10.0-windows</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="LibVLCSharp" Version="3.10.2" />
        <PackageReference Include="NAudio.Wasapi" Version="3.2.0" />
        <PackageReference Include="NAudio.WinMM" Version="3.2.0" />
        <PackageReference Include="Terminal.Gui" Version="2.5.0" />
        <PackageReference Include="Voxta.Client" Version="1.13.0-alpha.1" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.13" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    </ItemGroup>

    <!-- Native VLC for Windows; Linux/macOS use the system-installed VLC (the app degrades gracefully if missing). -->
    <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
        <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\scenario.json" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
